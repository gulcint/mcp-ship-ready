#!/usr/bin/env bash
# Conventional Commits zorunluluğu (GIT-KURALLARI.md §2, §12).
set -euo pipefail
MSG_FILE="$1"
subject=$(grep -vE '^\s*#' "$MSG_FILE" | sed -n '1p')

# Git'in kendi ürettiği mesajlara izin ver.
if [[ "$subject" =~ ^(Merge|Revert\ \"|fixup!|squash!) ]]; then exit 0; fi

re='^(feat|fix|docs|refactor|test|chore|security|ops)(\([a-z0-9._/-]+\))?!?: .{3,}'
if ! [[ "$subject" =~ $re ]]; then
  echo "commit-msg: mesaj Conventional Commits formatında değil:" >&2
  echo "  '$subject'" >&2
  echo "  beklenen: <tip>(<kapsam>): <özet>  — tip: feat|fix|docs|refactor|test|chore|security|ops" >&2
  exit 1
fi

# <rol>/<task_id>-... branch'inde mesaj task_id'yi içermeli (izlenebilirlik).
branch=$(git symbolic-ref --short -q HEAD || true)
if [[ "$branch" =~ ^[a-z-]+/(task-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9a-z]+) ]]; then
  task_id="${BASH_REMATCH[1]}"
  if ! grep -q "$task_id" "$MSG_FILE"; then
    echo "commit-msg: bu branch ($branch) için mesaj task_id içermeli: $task_id" >&2
    exit 1
  fi
fi
